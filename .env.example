# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=auth_db

# JWT configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ISSUER=auth-app
JWT_EXPIRY_HOURS=24h

# Server configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
ENVIRONMENT=development

# Swagger
ENABLE_SWAGGER=true